// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`SQL a calculation wraps the grouped query: gap-filled inner, window functions outside (app) 1`] = `
"SELECT toUnixTimestamp(__d) * 1000 AS b0, k1, b1, sum(ifNull(a0, 0)) OVER (PARTITION BY b1, k1 ORDER BY __d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS m0
FROM (
WITH top1 AS (SELECT toString("ServiceName") AS v FROM "default"."spec_logs" WHERE Timestamp >= $__fromTime AND Timestamp <= $__toTime AND v IS NOT NULL GROUP BY v ORDER BY count() DESC LIMIT 3)
SELECT toDateTime(toStartOfInterval("Timestamp", INTERVAL 1 DAY, 'UTC'), 'UTC') AS __d, multiIf(toString("ServiceName") IS NULL, 2, toString("ServiceName") GLOBAL IN (SELECT v FROM top1), 0, 1) AS k1, if(k1 = 0, toString("ServiceName"), '') AS b1, count() AS a0
FROM "default"."spec_logs"
WHERE Timestamp >= $__fromTime AND Timestamp <= $__toTime AND toString("ServiceName") IS NOT NULL
GROUP BY __d, b1, k1
ORDER BY b1, k1, __d WITH FILL FROM toDateTime(toStartOfInterval($__fromTime, INTERVAL 1 DAY, 'UTC'), 'UTC') TO $__toTime STEP INTERVAL 1 DAY
)
ORDER BY b0, b1, k1
LIMIT 10000"
`;

exports[`SQL every function in one query; nullable inner aggregates use -OrNull so empty buckets stay empty 1`] = `
"SELECT toUnixTimestamp(__d) * 1000 AS b0, (a0 - lagInFrame(toNullable(a0), 1, NULL) OVER (ORDER BY __d ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)) AS m0, if(isNull(a1), NULL, arrayReduce('avgOrNull', arraySlice(groupArray(a1) OVER (ORDER BY __d ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING), -2))) AS m1, (multiIf(lagInFrame(toNullable(a2), 1, NULL) OVER (ORDER BY __d ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) IS NULL, NULL, a2 >= lagInFrame(toNullable(a2), 1, NULL) OVER (ORDER BY __d ROWS BETWEEN 1 PRECEDING AND CURRENT ROW), a2 - lagInFrame(toNullable(a2), 1, NULL) OVER (ORDER BY __d ROWS BETWEEN 1 PRECEDING AND CURRENT ROW), a2)) * (1 / (toUnixTimestamp(__d + INTERVAL 1 DAY) - toUnixTimestamp(__d))) AS m2, a3 AS m3, a4 AS m4
FROM (
SELECT toDateTime(toStartOfInterval("Timestamp", INTERVAL 1 DAY, 'UTC'), 'UTC') AS __d, count() AS a0, quantileOrNull(0.5)("SeverityNumber") AS a1, maxOrNull("SeverityNumber") AS a2, stddevPopOrNull("SeverityNumber") AS a3, argMaxIfOrNull("SeverityNumber", Timestamp, "SeverityNumber" IS NOT NULL) AS a4
FROM "default"."spec_logs"
WHERE Timestamp >= $__fromTime AND Timestamp <= $__toTime
GROUP BY __d
ORDER BY __d WITH FILL FROM toDateTime(toStartOfInterval($__fromTime, INTERVAL 1 DAY, 'UTC'), 'UTC') TO $__toTime STEP INTERVAL 1 DAY
)
ORDER BY b0
LIMIT 10000"
`;

exports[`SQL saved panels compute the same calculation over $__timeInterval buckets 1`] = `
"SELECT b0, k1, b1, sum(ifNull(a0, 0)) OVER (PARTITION BY b1, k1 ORDER BY b0 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS m0
FROM (
WITH top1 AS (SELECT toString("ServiceName") AS v FROM "default"."spec_logs" WHERE Timestamp >= $__fromTime AND Timestamp <= $__toTime AND v IS NOT NULL GROUP BY v ORDER BY count() DESC LIMIT 3)
SELECT toDateTime(toStartOfInterval(toDateTime("Timestamp"), INTERVAL 1 * greatest(1, intDiv(toUnixTimestamp($__toTime) - toUnixTimestamp($__fromTime) + 43199999, 43200000)) DAY, 'UTC'), 'UTC') AS b0, multiIf(toString("ServiceName") IS NULL, 2, toString("ServiceName") GLOBAL IN (SELECT v FROM top1), 0, 1) AS k1, multiIf(k1 = 1, 'Other', k1 = 2, '(missing)', if(toString("ServiceName") IN ('Other'), concat(toString("ServiceName"), ' (value)'), toString("ServiceName"))) AS b1, count() AS a0
FROM "default"."spec_logs"
WHERE Timestamp >= $__fromTime AND Timestamp <= $__toTime AND toString("ServiceName") IS NOT NULL
GROUP BY b0, b1, k1
ORDER BY b1, k1, b0 WITH FILL FROM toDateTime(toStartOfInterval($__fromTime, INTERVAL 1 * greatest(1, intDiv(toUnixTimestamp($__toTime) - toUnixTimestamp($__fromTime) + 43199999, 43200000)) DAY, 'UTC'), 'UTC') TO $__toTime STEP INTERVAL 1 * greatest(1, intDiv(toUnixTimestamp($__toTime) - toUnixTimestamp($__fromTime) + 43199999, 43200000)) DAY
)
ORDER BY b0, b1, k1
LIMIT 10000"
`;
